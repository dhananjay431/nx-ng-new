{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "customer/Routes": [
        "./apps/customer/src/app/remote-entry/entry.routes.ts"
      ],
      "billing/Routes": ["./apps/billing/src/app/remote-entry/entry.routes.ts"],
      "reports/Routes": ["./apps/reports/src/app/remote-entry/entry.routes.ts"],
      "@ng20/ui": ["./libs/shared/ui/src/index.ts"],
      "@ng20/layout": ["./libs/shared/layout/src/index.ts"],
      "@ng20/auth": ["./libs/shared/auth/src/index.ts"],
      "@ng20/api": ["./libs/shared/api/src/index.ts"],
      "@ng20/models": ["./libs/shared/models/src/index.ts"],
      "@ng20/utils": ["./libs/shared/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
